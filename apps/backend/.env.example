# Backend configuration (copy to apps/backend/.env and fill in your own values)
PORT=4000

# PostgreSQL database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=vaxcare

# Alternatively, use a managed PostgreSQL connection string instead of DB_*
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique random secret (at least 32 characters) for each environment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long

# Comma-separated allowed frontend origins for CORS (e.g. your Vercel production domain and local dev)
CORS_ALLOWED_ORIGINS=https://your-vaxcare-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Defaults to false and MUST remain OFF (false) in production.
# Vercel preview environments use dynamic URLs that cannot validate against production reCAPTCHA tokens.
ALLOW_VERCEL_PREVIEWS=false

# Rate limiting settings (keyed by real client IP via Fly-Client-IP / trust proxy = 1)
# Defaults: 10 login requests per 15 min; 20 resident registrations per 15 min.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=20

# Google reCAPTCHA v3 Secret Key (keep on backend only / Fly.io secrets; never commit or expose)
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# Minimum risk score threshold (0.0 = bot, 1.0 = human, default is 0.5)
RECAPTCHA_MIN_SCORE=0.5

# Comma-separated expected frontend hostname(s) (e.g. your-app.vercel.app). Leave blank in local dev to skip.
RECAPTCHA_EXPECTED_HOSTNAME=your-vaxcare-app.vercel.app
