# Backend configuration (copy to apps/backend/.env and fill in your own values)
PORT=4000

# Local PostgreSQL example
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=vaxcare

# Alternatively, use a managed PostgreSQL connection string instead of DB_*.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique random secret (at least 32 characters) for each environment.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long

# Comma-separated allowed frontend origins. Keep localhost for local development.
CORS_ORIGIN=http://localhost:5173
